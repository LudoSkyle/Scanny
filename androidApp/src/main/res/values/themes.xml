<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Scanny" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- While the app starts: its icon on the white of the icon, then the theme of the app -->
    <style name="Theme.Scanny.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Scanny</item>
    </style>
</resources>
