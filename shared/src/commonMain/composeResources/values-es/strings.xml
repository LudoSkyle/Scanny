    <string name="format">Formato</string>
    <string name="format_aztec_example">Un billete de tren guarda su reserva, su trayecto y su pasajero en un código Aztec de unos cientos de caracteres.</string>
    <string name="format_aztec_structure">Una diana de cuadrados en su centro, que permite al lector encontrarlo, rodeada de capas de módulos, de 15 × 15 a 151 × 151. No necesita ningún margen blanco a su alrededor.</string>
    <string name="format_aztec_use">Billetes de tren y de avión.</string>
    <string name="format_codabar_example">`A40156B`: el número `40156` entre `A` y `B`.</string>
    <string name="format_codabar_structure">Dígitos y seis signos (- $ : / . +), enmarcados por una letra de inicio y una letra de fin, A, B, C o D.</string>
    <string name="format_codabar_use">Bibliotecas, bancos de sangre y servicios de paquetería.</string>
    <string name="format_code_128_example">El número de paquete `123456` se escribe en 3 caracteres del juego de dígitos.</string>
    <string name="format_code_128_structure">Cada carácter ocupa 11 módulos de 3 barras y 3 espacios. Tres juegos de caracteres cubren las mayúsculas, las minúsculas y los dígitos; el último escribe dos dígitos por carácter. Un carácter de control precede al patrón de fin.</string>
    <string name="format_code_128_use">Etiquetas de envío y logística.</string>
    <string name="format_code_39_example">`SCANNY` se escribe `*SCANNY*`, entre sus dos asteriscos.</string>
    <string name="format_code_39_structure">Mayúsculas, dígitos y algunos signos. Cada carácter son 9 barras y espacios, 3 de ellos anchos, de ahí su otro nombre, Code 3 of 9. Un asterisco abre el código y otro lo cierra.</string>
    <string name="format_code_39_use">Industria, logística y credenciales.</string>
    <string name="format_code_93_example">`SCANNY` se lee como en Code 39, en un ancho menor, con sus dos caracteres de control antes del final.</string>
    <string name="format_code_93_structure">Los caracteres del Code 39, cada uno en 9 módulos de 3 barras y 3 espacios, seguidos de dos caracteres de control: más denso que el Code 39, y más seguro.</string>
    <string name="format_code_93_use">Logística y servicios postales.</string>
    <string name="format_data_matrix_example">Un número de serie de 10 dígitos cabe en un cuadrado de 12 × 12 módulos.</string>
    <string name="format_data_matrix_structure">Un cuadrado o un rectángulo de módulos, de 10 × 10 a 144 × 144. Una L continua en dos lados permite al lector encontrarlo; una línea de puntos en los otros dos indica su tamaño.</string>
    <string name="format_data_matrix_use">Impreso en diminuto en componentes electrónicos, medicamentos y correo.</string>
    <string name="format_ean_13_example">`4006381333931`: `400` para Alemania, `6381` para la empresa, `33393` para el producto, `1` para el control.</string>
    <string name="format_ean_13_structure">13 dígitos: el prefijo del país donde está registrada la empresa, el número de la empresa, el del producto y un dígito de control calculado a partir de los otros 12, que delata un error de lectura.</string>
    <string name="format_ean_13_use">Los productos vendidos en casi todo el mundo.</string>
    <string name="format_ean_8_example">`96385074`: `963` para el prefijo, `8507` para el producto, `4` para el control.</string>
    <string name="format_ean_8_structure">8 dígitos: un prefijo, el número del producto, asignado completo por la organización GS1, y un dígito de control.</string>
    <string name="format_ean_8_use">Los productos pequeños sin espacio para un EAN-13.</string>
    <string name="format_example">Ejemplo</string>
    <string name="format_itf_example">`15400141288763`, en una caja: `1` para el embalaje, `540014128876` para el producto que contiene, `3` para el control.</string>
    <string name="format_itf_structure">Dígitos en pares, intercalados: el primero en las barras, el segundo en los espacios entre ellas. Cada dígito son 5 elementos, 2 de ellos anchos, de ahí su nombre, Interleaved 2 of 5.</string>
    <string name="format_itf_use">Cajas y palés, como ITF-14.</string>
    <string name="format_pdf417_example">El reverso de un permiso de conducir estadounidense guarda el nombre, la dirección y la fecha de nacimiento de su titular en un PDF417.</string>
    <string name="format_pdf417_structure">Filas apiladas, de 3 a 90, de palabras de código. Cada palabra de código son 4 barras y 4 espacios en 17 módulos, de ahí su nombre. Un patrón de inicio y otro de fin enmarcan cada fila.</string>
    <string name="format_pdf417_use">Documentos de identidad, permisos de conducir y tarjetas de embarque.</string>
    <string name="format_qr_code_example">`https://scanny.app`, 18 caracteres, cabe en un cuadrado de 25 × 25 módulos con la corrección más baja.</string>
    <string name="format_qr_code_structure">Un cuadrado de módulos blancos y negros, de 21 × 21 a 177 × 177. Tres cuadrados en sus esquinas permiten al lector encontrarlo y orientarlo. El contenido se escribe en binario, repetido en parte por su corrección de errores, para que el código se lea aunque esté dañado.</string>
    <string name="format_qr_code_use">El código más común: enlaces, pagos, menús, entradas, redes Wi-Fi.</string>
    <string name="format_read_and_created">Scanny lo lee y lo crea.</string>
    <string name="format_structure">Cómo está hecho</string>
    <string name="format_upc_a_example">`036000291452`: `0` para el sistema, `36000` para la empresa, `29145` para el producto, `2` para el control.</string>
    <string name="format_upc_a_structure">12 dígitos: un sistema de numeración, 0 para la mayoría de los productos, 5 dígitos para la empresa, 5 para el producto y un dígito de control. Es un EAN-13 que empieza por 0.</string>
    <string name="format_upc_a_use">Los productos vendidos en Norteamérica.</string>
    <string name="format_upc_e_example">`04252614` es la forma corta del UPC-A `042100005264`.</string>
    <string name="format_upc_e_structure">Un UPC-A acortado a 8 dígitos quitando sus ceros: el sistema de numeración, 6 dígitos que contienen la empresa y el producto, y el dígito de control.</string>
    <string name="format_upc_e_use">Los productos pequeños vendidos en Norteamérica.</string>
    <string name="format_use">Su uso</string>
