    <string name="format">Format</string>
    <string name="format_aztec_example">Un billet de train tient sa réservation, son trajet et son voyageur dans un code Aztec de quelques centaines de caractères.</string>
    <string name="format_aztec_structure">Une cible de carrés en son centre, qui permet au lecteur de le trouver, entourée de couches de modules, de 15 × 15 à 151 × 151. Il n'a besoin d'aucune marge blanche autour de lui.</string>
    <string name="format_aztec_use">Les billets de train et d'avion.</string>
    <string name="format_codabar_example">A40156B : le numéro 40156 entre A et B.</string>
    <string name="format_codabar_structure">Des chiffres et six signes (- $ : / . +), encadrés par une lettre de début et une lettre de fin, A, B, C ou D.</string>
    <string name="format_codabar_use">Les bibliothèques, les banques du sang et les services de colis.</string>
    <string name="format_code_128_example">Le numéro de colis 123456 s'écrit en 3 caractères du jeu des chiffres.</string>
    <string name="format_code_128_structure">Chaque caractère fait 11 modules de 3 barres et 3 espaces. Trois jeux de caractères couvrent les majuscules, les minuscules et les chiffres, le dernier écrivant deux chiffres par caractère. Un caractère de contrôle précède le motif de fin.</string>
    <string name="format_code_128_use">Les étiquettes d'expédition et la logistique.</string>
    <string name="format_code_39_example">SCANNY s'écrit *SCANNY*, entre ses deux astérisques.</string>
    <string name="format_code_39_structure">Des majuscules, des chiffres et quelques signes. Chaque caractère fait 9 barres et espaces, dont 3 larges, d'où son autre nom, Code 3 parmi 9. Un astérisque ouvre le code, un autre le ferme.</string>
    <string name="format_code_39_use">L'industrie, la logistique et les badges.</string>
    <string name="format_code_93_example">SCANNY se lit comme en Code 39, sur une largeur plus courte, avec ses deux caractères de contrôle avant la fin.</string>
    <string name="format_code_93_structure">Les caractères du Code 39, chacun en 9 modules de 3 barres et 3 espaces, suivis de deux caractères de contrôle : plus dense que le Code 39, et plus sûr.</string>
    <string name="format_code_93_use">La logistique et les services postaux.</string>
    <string name="format_data_matrix_example">Un numéro de série de 10 chiffres tient dans un carré de 12 × 12 modules.</string>
    <string name="format_data_matrix_structure">Un carré ou un rectangle de modules, de 10 × 10 à 144 × 144. Un L plein sur deux côtés permet au lecteur de le trouver, une ligne en pointillés sur les deux autres donne sa taille.</string>
    <string name="format_data_matrix_use">Imprimé en tout petit sur les composants électroniques, les médicaments et le courrier.</string>
    <string name="format_ean_13_example">4006381333931 : 400 pour l'Allemagne, 6381 pour l'entreprise, 33393 pour le produit, 1 pour le contrôle.</string>
    <string name="format_ean_13_structure">13 chiffres : le préfixe du pays où l'entreprise est enregistrée, le numéro de l'entreprise, celui du produit, puis un chiffre de contrôle calculé sur les 12 autres, qui révèle une erreur de lecture.</string>
    <string name="format_ean_13_use">Les produits vendus presque partout dans le monde.</string>
    <string name="format_ean_8_example">96385074 : 963 pour le préfixe, 8507 pour le produit, 4 pour le contrôle.</string>
    <string name="format_ean_8_structure">8 chiffres : un préfixe, le numéro du produit, attribué en entier par l'organisme GS1, puis un chiffre de contrôle.</string>
    <string name="format_ean_8_use">Les petits produits sans place pour un EAN-13.</string>
    <string name="format_example">Exemple</string>
    <string name="format_itf_example">15400141288763, sur un carton : 1 pour le conditionnement, 540014128876 pour le produit qu'il contient, 3 pour le contrôle.</string>
    <string name="format_itf_structure">Des chiffres par paires, entrelacés : le premier dans les barres, le second dans les espaces entre elles. Chaque chiffre fait 5 éléments, dont 2 larges, d'où son nom, 2 parmi 5 entrelacé.</string>
    <string name="format_itf_use">Les cartons et les palettes, en ITF-14.</string>
    <string name="format_pdf417_example">Le dos d'un permis de conduire américain porte le nom, l'adresse et la date de naissance de son titulaire dans un PDF417.</string>
    <string name="format_pdf417_structure">Des rangées empilées, de 3 à 90, de mots-codes. Chaque mot-code fait 4 barres et 4 espaces sur 17 modules, d'où son nom. Un motif de début et un motif de fin encadrent chaque rangée.</string>
    <string name="format_pdf417_use">Les cartes d'identité, les permis de conduire et les cartes d'embarquement.</string>
    <string name="format_qr_code_example">« https://scanny.app », 18 caractères, tient dans un carré de 25 × 25 modules à la correction la plus faible.</string>
    <string name="format_qr_code_structure">Un carré de modules noirs et blancs, de 21 × 21 à 177 × 177. Trois carrés dans ses coins permettent au lecteur de le trouver et de le remettre droit. Le contenu y est écrit en binaire, répété en partie par sa correction d'erreur : le code se lit encore abîmé.</string>
    <string name="format_qr_code_use">Le code le plus répandu : liens, paiements, menus, billets, réseaux Wi-Fi.</string>
    <string name="format_read_and_created">Scanny le lit et le crée.</string>
    <string name="format_structure">Comment il est formé</string>
    <string name="format_upc_a_example">036000291452 : 0 pour le système, 36000 pour l'entreprise, 29145 pour le produit, 2 pour le contrôle.</string>
    <string name="format_upc_a_structure">12 chiffres : un système de numérotation, 0 pour la plupart des produits, 5 chiffres pour l'entreprise, 5 pour le produit, puis un chiffre de contrôle. C'est un EAN-13 qui commence par 0.</string>
    <string name="format_upc_a_use">Les produits vendus en Amérique du Nord.</string>
    <string name="format_upc_e_example">04252614 est la forme courte de l'UPC-A 042100005264.</string>
    <string name="format_upc_e_structure">Un UPC-A raccourci à 8 chiffres en retirant ses zéros : le système de numérotation, 6 chiffres qui tiennent l'entreprise et le produit, puis le chiffre de contrôle.</string>
    <string name="format_upc_e_use">Les petits produits vendus en Amérique du Nord.</string>
    <string name="format_use">Son usage</string>
